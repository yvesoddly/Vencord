{
    "name": "vencord",
    "private": "true",
    "version": "1.15.11",
    "description": "The cutest Discord client mod",
    "homepage": "https://github.com/Vendicated/Vencord#readme",
    "bugs": {
        "url": "https://github.com/Vendicated/Vencord/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vendicated/Vencord.git"
    },
    "license": "GPL-3.0-or-later",
    "type": "module",
    "author": "Vendicated",
    "scripts": {
        "prepare": "vp config --no-agent",
        "build": "node scripts/build/build.ts desktop",
        "buildStandalone": "node scripts/build/build.ts desktop --standalone",
        "buildWeb": "node scripts/build/build.ts web",
        "buildWebStandalone": "node scripts/build/build.ts web --standalone",
        "buildReporter": "node scripts/build/build.ts web --standalone --reporter --skip-extension",
        "buildReporterDesktop": "node scripts/build/build.ts desktop --reporter",
        "watch": "node scripts/build/build.ts desktop --watch",
        "dev": "node scripts/build/build.ts desktop --watch",
        "watchWeb": "node scripts/build/build.ts web --watch",
        "report": "vp run buildReporter && node scripts/generateReport.ts",
        "generatePluginJson": "node scripts/generatePluginList.ts",
        "sync:reference": "node scripts/syncReference.ts",
        "inject": "node scripts/runInstaller.ts -- --install",
        "uninject": "node scripts/runInstaller.ts -- --uninstall",
        "lint-styles": "stylelint \"src/**/*.css\" --ignore-pattern src/userplugins",
        "verify": "vp check && vp test run && vp run lint-styles && vp run buildStandalone && vp run buildWebStandalone && vp run generatePluginJson dist/plugins.json dist/plugin-readmes.json"
    },
    "dependencies": {
        "@intrnl/xxhash64": "^0.1.2",
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "fflate": "^0.8.3",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
        "monaco-editor": "^0.55.1",
        "nanoid": "^5.1.16",
        "virtual-merge": "^1.0.1"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.5",
        "@puppeteer/browsers": "3.2.5",
        "@types/chrome": "^0.2.0",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.0.1",
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.0",
        "@vencord/discord-types": "link:packages/discord-types",
        "diff": "^9.0.0",
        "effect": "4.0.5",
        "highlight.js": "11.11.1",
        "html-minifier-terser": "^7.2.0",
        "lightningcss": "1.33.0",
        "moment": "^2.22.2",
        "p-limit": "^7.3.0",
        "puppeteer-core": "^25.2.1",
        "standalone-electron-types": "^41.2.1",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "ts-pattern": "^5.9.0",
        "type-fest": "^5.7.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
        "vite-plus": "1.2.0"
    },
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=24"
    }
}
